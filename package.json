{
  "name": "silogu-app",
  "version": "1.1.0",
  "description": "小龙果桌面应用（加载共享网站 UI，提供原生下载）",
  "main": "main.js",
  "author": "xlg0722",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.silogu.app",
    "productName": "小龙果",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../网站", "to": "网站" }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "siloguApp.exe"
    }
  }
}