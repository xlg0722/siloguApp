{
  "name": "silogu-app",
  "version": "1.3.0",
  "description": "小龙果桌面应用（加载共享网站 UI，提供原生下载与增量更新）",
  "author": "xlg0722",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir && node scripts/build-update-manifest.js",
    "manifest": "node scripts/build-update-manifest.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.silogu.app",
    "productName": "小龙果",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../网站", "to": "网站" }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
